import java.io.BufferedReader;
import java.io.FileReader;
import java.io.IOException;

public class nohmsmplcd
{
    public static void main(String[] args)
    {
        String fileName = "testtext.txt";
        String line;

        String[] empIds = new String[100];
        int[] qtyTotals = new int[100];
        int[] valueTotals = new int[100];
        int empCount = 0;

        try (BufferedReader br = new BufferedReader(new FileReader(fileName)))
        {
            System.out.println("ItemCode\tProduct\tUnit Price\tQty\tDate\tRep ID");

            while ((line = br.readLine()) != null)
            {
                System.out.println(line);

                if (line.startsWith("ItemCode")) continue;

                String[] parts = line.split("\t");
                String itemCode = parts[0];
                int unitPrice = Integer.parseInt(parts[2]);
                int qty = Integer.parseInt(parts[3]);
                String repId = parts[5];

                if (itemCode.equals("D"))
                {

                    boolean found = false;
                    for (int i = 0; i < empCount; i++)
                    {
                        if (empIds[i].equals(repId))
                        {
                            qtyTotals[i] += qty;
                            valueTotals[i] += qty * unitPrice;
                            found = true;
                            break;
                        }
                    }

                    if (!found)
                    {
                        empIds[empCount] = repId;
                        qtyTotals[empCount] = qty;
                        valueTotals[empCount] = qty * unitPrice;
                        empCount++;
                    }
                }
            }
        } catch (IOException e)
        {
            e.printStackTrace();
        }
        System.out.println("\nTotal Product D by Employee ID:");
        for (int i = 0; i < empCount; i++)
        {
            System.out.println(empIds[i] + " -> Qty: " + qtyTotals[i] + ", Sales Value: " + valueTotals[i]);
        }
    }
}
